---
interface Props { links: Record<string, string>; details?: string; exclude?: string[] }
const { links, details, exclude = [] } = Astro.props;
const visibleLinks = Object.entries(links).filter(([, href]) => !exclude.includes(href));
---
{(visibleLinks.length > 0 || details) && <div class="research-links">
  {visibleLinks.map(([label, href]) => (
    <a class:list={['resource-link', { primary: label === 'Try demo' }]} href={href} rel="noopener">
      {label}<span aria-hidden="true"> ↗</span>
    </a>
  ))}
  {details && <a class="details-link" href={details}>Research details <span aria-hidden="true">→</span></a>}
</div>}
