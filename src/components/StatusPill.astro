---
// 状态双通道:形状 + 颜色,不只靠颜色。见 CLAUDE.md §4.3
interface Props { status: string; shape: 'solid' | 'half' | 'hollow' }
const { status, shape } = Astro.props;
---
<span class="status">
  <svg viewBox="0 0 11 11" aria-hidden="true">
    <circle class="mk" cx="5.5" cy="5.5" r="4" />
    {shape === 'solid' && <circle class="mk solid" cx="5.5" cy="5.5" r="4" />}
    {shape === 'half' && <path class="mk half" d="M5.5 1.5a4 4 0 0 1 0 8z" stroke="none" />}
  </svg>{status}
</span>
