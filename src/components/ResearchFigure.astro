---
interface Figure {
  src: string;
  alt: string;
  caption: string;
  sourceLabel: string;
  sourceUrl?: string;
}
interface Props { figure: Figure; compact?: boolean }
const { figure, compact = false } = Astro.props;
---
<figure class:list={['research-figure', { compact }]}>
  <a class="figure-image" href={figure.src} target="_blank" rel="noopener" aria-label={`View full-size figure: ${figure.alt}`}>
    <img src={figure.src} alt={figure.alt} loading="lazy" decoding="async" />
  </a>
  <figcaption>
    {!compact && <span class="figure-caption">{figure.caption}</span>}
    <span class="figure-credit">
      {figure.sourceUrl ? (
        <a class="figure-source" href={figure.sourceUrl} rel="noopener">{figure.sourceLabel} ↗</a>
      ) : <span class="figure-source">{figure.sourceLabel}</span>}
      <a class="figure-full" href={figure.src} target="_blank" rel="noopener">Full size ↗</a>
    </span>
  </figcaption>
</figure>
