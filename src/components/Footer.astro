---
import { site, isTodo } from '../lib/site';
const { email, github } = site.links;
---
<footer class="foot">
  <a href={`mailto:${email}`}>{email}</a>
  {isTodo(github)
    ? <span class="todo">{github}</span>
    : <a href={`https://github.com/${github}`} rel="me">github.com/{github}</a>}
  <span class="sp">Providence, RI</span>
</footer>
