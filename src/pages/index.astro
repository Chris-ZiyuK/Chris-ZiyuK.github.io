---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import StatusPill from '../components/StatusPill.astro';
import ResearchFigure from '../components/ResearchFigure.astro';
import ResearchLinks from '../components/ResearchLinks.astro';
import { site } from '../lib/site';

const entries = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order,
);
const paragraphs = site.intro.split('\n\n').filter((p) => p.trim());
---
<Base title={`${site.name} — Information retrieval`} current="home">
  <main class="wrap">
    <header class="hero rise">
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <ul class="affil">
        {site.affiliations.map((a) => (
          <li>
            <span>{a.role}</span>
            <span class="org">{a.org}</span>
            <span class="yr">{a.detail}</span>
          </li>
        ))}
      </ul>
      <div class="intro">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </header>

    <section class="sec showcase rise" aria-labelledby="selected-research">
      <div class="section-heading">
        <h2 id="selected-research">Selected research</h2>
        <a href="/research/">All research <span aria-hidden="true">→</span></a>
      </div>
      {entries.map((e) => (
        <article class="showcase-entry">
          <ResearchFigure figure={e.data.figure} compact />
          <div class="showcase-copy">
            <p class="research-label">{e.data.label}</p>
            <h3><a href={`/research/#${e.data.slug}`}>{e.data.short}</a></h3>
            <div class="showcase-meta">
              <StatusPill status={e.data.status} shape={e.data.status_shape} />
              <span>{e.data.period}</span>
            </div>
            <p class="takeaway">{e.data.takeaway}</p>
            <p class="contribution"><strong>My contribution.</strong> {e.data.contribution}</p>
            <ResearchLinks links={e.data.links} details={`/research/#${e.data.slug}`} />
          </div>
        </article>
      ))}
    </section>

    <section class="sec rise">
      <h2>{site.engineering.heading}</h2>
      <p class="lead">{site.engineering.lead}</p>
      <ul class="eng-list">
        {site.engineering.items.map((i) => <li>{i}</li>)}
      </ul>
    </section>

    <Footer />
  </main>
</Base>
