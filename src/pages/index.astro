---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import StatusPill from '../components/StatusPill.astro';
import ResearchFigure from '../components/ResearchFigure.astro';
import ResearchLinks from '../components/ResearchLinks.astro';
import ResearchHighlights from '../components/ResearchHighlights.astro';
import { site } from '../lib/site';

const entries = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order,
);
const paragraphs = site.intro.split('\n\n').filter((p) => p.trim());
---
<Base title={`${site.name} — Information retrieval`} current="home">
  <main class="wrap">
    <header class="hero profile">
      <div class="profile-main">
        <h1>{site.name}</h1>
        <div class="intro">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="profile-links">
          <a href={`mailto:${site.links.email}`}>Email <span aria-hidden="true">↗</span></a>
          <a href={`https://github.com/${site.links.github}`} rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
          <a href="/cv/">Curriculum vitae <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="profile-background" aria-label={site.background_heading}>
        <h2>{site.background_heading}</h2>
        <ul class="affil">
          {site.affiliations.map((a) => (
            <li>
              <span class="affil-role">{a.role}</span>
              <span class="org">{a.org}<span class="yr"> · {a.detail}</span></span>
            </li>
          ))}
        </ul>
      </aside>
    </header>

    <section class="sec showcase" aria-labelledby="selected-research">
      <div class="section-heading">
        <h2 id="selected-research">{site.research_heading}</h2>
        <a href="/research/">Explore the research <span aria-hidden="true">→</span></a>
      </div>
      {entries.map((e) => (
        <article class="showcase-entry">
          <div class="showcase-copy">
            <p class="research-label">{e.data.label}</p>
            <div class="project-title">
              <h3><a href={`/research/#${e.data.slug}`}>{e.data.short}</a></h3>
              <ResearchHighlights highlights={e.data.highlights} status={e.data.status_highlight ? e.data.status : undefined} shape={e.data.status_shape} />
            </div>
            <div class="showcase-meta">
              {!e.data.status_highlight && <StatusPill status={e.data.status} shape={e.data.status_shape} />}
              <span>{e.data.period}</span>
            </div>
            <p class="takeaway">{e.data.takeaway}</p>
            <p class="contribution">{e.data.contribution}</p>
            <ResearchLinks links={e.data.links} exclude={e.data.highlights.flatMap(h => h.href ? [h.href] : [])} details={`/research/#${e.data.slug}`} />
          </div>
          <ResearchFigure figure={e.data.figure} compact />
        </article>
      ))}
    </section>

    <section class="sec engineering">
      <h2>{site.engineering.heading}</h2>
      <ul class="eng-list">
        {site.engineering.items.map((i) => <li>{i}</li>)}
      </ul>
    </section>

    <Footer />
  </main>
</Base>
