---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import StatusPill from '../../components/StatusPill.astro';
import ResearchFigure from '../../components/ResearchFigure.astro';
import ResearchLinks from '../../components/ResearchLinks.astro';
import ResearchHighlights from '../../components/ResearchHighlights.astro';
import { site } from '../../lib/site';

const entries = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  entries.map(async (e) => ({ data: e.data, Content: (await render(e)).Content })),
);
---
<Base title={`Research — ${site.name}`} current="research">
  <main class="wrap">
    <header class="hero page-heading">
      <h1>Research</h1>
    </header>

    <nav class="research-index" aria-label="Research projects">
      {entries.map((e) => <a href={`#${e.data.slug}`}>{e.data.short}</a>)}
    </nav>

    <section class="sec">
      {rendered.map(({ data, Content }) => (
        <article class="entry" id={data.slug}>
          <div class="entry-heading">
            <p class="research-label">{data.label}</p>
            <div class="project-title">
              <h2>{data.title}</h2>
              <ResearchHighlights highlights={data.highlights} status={data.status_highlight ? data.status : undefined} shape={data.status_shape} />
            </div>
            {data.authors && <p class="authors">{data.authors}</p>}
            <div class="meta">
              <span class="role">{data.role}</span>
              <span class="yr">{data.period}</span>
              {!data.status_highlight && <StatusPill status={data.status} shape={data.status_shape} />}
            </div>
            {data.funding && <p class="prov">{data.funding}</p>}
          </div>
          <div class:list={['entry-grid', { 'wide-figure': data.figure.wide }]}>
            {data.figure.wide && <ResearchFigure figure={data.figure} />}
            <div class="entry-narrative">
              <p class="research-takeaway">{data.takeaway}</p>
              <ResearchLinks links={data.links} exclude={data.highlights.flatMap(h => h.href ? [h.href] : [])} />
              <div class="body"><Content /></div>
            </div>
            {!data.figure.wide && <ResearchFigure figure={data.figure} />}
          </div>
          {data.secondaryFigure && <ResearchFigure figure={data.secondaryFigure} />}
          <div class="tags" aria-label="Research topics">{data.tags.map((t) => <span>{t}</span>)}</div>
        </article>
      ))}
    </section>

    <Footer />
  </main>
</Base>
